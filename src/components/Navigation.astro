---
---

<header class="navigation">
  <div class="navigation-inner">
    <a
      href="/"
      class="brand"
      aria-label="Freya — Home"
    >
      <span class="brand-mark">F</span>

      <span class="brand-name">
        Freya
      </span>
    </a>

    <nav
      class="desktop-nav"
      aria-label="Primary navigation"
    >
      <a href="#systems">Systems</a>
      <a href="#ownership">Ownership</a>
      <a href="#career">Career</a>
      <a href="#stack">Stack</a>
      <a href="#about">About</a>
    </nav>

    <a
      href="#contact"
      class="nav-contact"
    >
      Let's talk
      <span aria-hidden="true">↗</span>
    </a>

    <button
      class="mobile-toggle"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="mobile-menu"
    aria-label="Mobile navigation"
  >
    <a href="#systems">Systems</a>
    <a href="#ownership">Ownership</a>
    <a href="#career">Career</a>
    <a href="#stack">Stack</a>
    <a href="#about">About</a>
    <a href="#contact">Let's talk ↗</a>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(
    ".mobile-toggle"
  );

  const menu = document.querySelector<HTMLElement>(
    "#mobile-menu"
  );

  const links = menu?.querySelectorAll("a");

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const isOpen =
        toggle.getAttribute("aria-expanded") === "true";

      toggle.setAttribute(
        "aria-expanded",
        String(!isOpen)
      );

      menu.classList.toggle("is-open", !isOpen);
      document.body.classList.toggle(
        "menu-open",
        !isOpen
      );
    });

    links?.forEach((link) => {
      link.addEventListener("click", () => {
        toggle.setAttribute(
          "aria-expanded",
          "false"
        );

        menu.classList.remove("is-open");
        document.body.classList.remove(
          "menu-open"
        );
      });
    });
  }
</script>

<style lang="scss">
  @import "../styles/variables";

  .navigation {
    position: fixed;
    z-index: 100;

    top: 0;
    left: 0;

    width: 100%;

    border-bottom: 1px solid rgba(255, 255, 255, 0.06);

    background: rgba(7, 11, 18, 0.72);

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .navigation-inner {
    display: flex;
    align-items: center;

    width: min(
      calc(100% - 3rem),
      $container-max
    );

    height: $nav-height;

    margin-inline: auto;
  }

  // ----------------------------------------------------------
  // Brand
  // ----------------------------------------------------------

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;

    flex-shrink: 0;
  }

  .brand-mark {
    display: grid;
    place-items: center;

    width: 32px;
    height: 32px;

    border: 1px solid rgba(77, 163, 255, 0.28);
    border-radius: $radius-sm;

    background:
      linear-gradient(
        135deg,
        rgba(77, 163, 255, 0.14),
        rgba(139, 124, 255, 0.1)
      );

    font-family: $font-mono;
    font-size: $text-sm;
    font-weight: $weight-semibold;

    color: $text-primary;
  }

  .brand-name {
    font-size: $text-sm;
    font-weight: $weight-semibold;
    letter-spacing: -0.01em;
  }

  // ----------------------------------------------------------
  // Desktop navigation
  // ----------------------------------------------------------

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.8rem;

    margin-inline: auto;
  }

  .desktop-nav a {
    position: relative;

    font-size: $text-sm;
    color: $text-secondary;

    transition:
      color $transition-fast;
  }

  .desktop-nav a::after {
    content: "";

    position: absolute;

    right: 0;
    bottom: -7px;
    left: 0;

    height: 1px;

    background: $accent-blue;

    transform: scaleX(0);
    transform-origin: right;

    transition:
      transform $transition-base;
  }

  .desktop-nav a:hover {
    color: $text-primary;
  }

  .desktop-nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  // ----------------------------------------------------------
  // Contact CTA
  // ----------------------------------------------------------

  .nav-contact {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;

    padding: 0.55rem 0.85rem;

    border: 1px solid $border-default;
    border-radius: $radius-md;

    background: rgba(255, 255, 255, 0.025);

    font-size: $text-sm;
    color: $text-primary;

    transition:
      border-color $transition-base,
      background $transition-base,
      transform $transition-base;
  }

  .nav-contact span {
    color: $accent-blue;
  }

  .nav-contact:hover {
    transform: translateY(-1px);

    border-color: rgba(77, 163, 255, 0.35);
    background: rgba(77, 163, 255, 0.06);
  }

  // ----------------------------------------------------------
  // Mobile
  // ----------------------------------------------------------

  .mobile-toggle {
    display: none;

    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;

    width: 40px;
    height: 40px;

    margin-left: auto;

    border: 1px solid $border-default;
    border-radius: $radius-md;

    background: transparent;

    cursor: pointer;
  }

  .mobile-toggle span {
    display: block;

    width: 16px;
    height: 1px;

    background: $text-primary;

    transition:
      transform $transition-base;
  }

  .mobile-menu {
    display: none;
  }

  // ----------------------------------------------------------
  // Mobile breakpoint
  // ----------------------------------------------------------

  @media (max-width: $breakpoint-md) {
    .navigation-inner {
      width: min(
        calc(100% - 2rem),
        $container-max
      );
    }

    .desktop-nav,
    .nav-contact {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }

    .mobile-menu {
      display: flex;

      flex-direction: column;
      gap: 0.25rem;

      max-height: 0;
      overflow: hidden;

      padding-inline: 1rem;

      border-top: 1px solid transparent;

      opacity: 0;

      transition:
        max-height $transition-slow,
        opacity $transition-base,
        padding $transition-slow,
        border-color $transition-base;
    }

    .mobile-menu.is-open {
      max-height: 420px;

      padding-top: 1rem;
      padding-bottom: 1rem;

      border-color: $border-subtle;

      opacity: 1;
    }

    .mobile-menu a {
      padding: 0.8rem;

      border-radius: $radius-md;

      font-size: $text-base;
      color: $text-secondary;

      transition:
        background $transition-fast,
        color $transition-fast;
    }

    .mobile-menu a:hover {
      background: rgba(255, 255, 255, 0.04);
      color: $text-primary;
    }
  }

  // ----------------------------------------------------------
  // Reduced motion
  // ----------------------------------------------------------

  @media (prefers-reduced-motion: reduce) {
    .desktop-nav a::after,
    .nav-contact,
    .mobile-toggle span,
    .mobile-menu,
    .mobile-menu a {
      transition: none;
    }
  }
</style>