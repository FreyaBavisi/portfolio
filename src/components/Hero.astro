---
---

<section class="hero" id="home">
  <div class="hero-grid"></div>

  <div class="hero-glow hero-glow-one"></div>
  <div class="hero-glow hero-glow-two"></div>

  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-eyebrow reveal-up">
        <span class="status-dot"></span>
        <span>Backend-focused Full Stack Developer</span>
      </div>

      <h1 class="hero-title reveal-up stagger-1">
        I BUILD
        <span class="gradient-text"> SYSTEMS,</span>
        <br />
        NOT JUST
        <span class="hero-outline"> FEATURES.</span>
      </h1>

      <p class="hero-description reveal-up stagger-2">
        I build production web applications, backend systems,
        APIs, and business workflows — with a focus on
        architecture, data, and reliable delivery.
      </p>

      <div class="hero-actions reveal-up stagger-3">
        <a
          href="#systems"
          class="button button-primary"
        >
          Explore my work
          <span aria-hidden="true">↓</span>
        </a>

        <a
          href="#contact"
          class="button button-secondary"
        >
          Let's talk
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="hero-metrics reveal-up stagger-4">
        <div class="metric">
          <strong>3+</strong>
          <span>Years experience</span>
        </div>

        <div class="metric-divider"></div>

        <div class="metric">
          <strong>3</strong>
          <span>Product domains</span>
        </div>

        <div class="metric-divider"></div>

        <div class="metric">
          <strong>20+</strong>
          <span>Major modules</span>
        </div>
      </div>
    </div>

    <!-- ================================================== -->
    <!-- System Map -->
    <!-- ================================================== -->

    <div class="system-visual reveal-up stagger-2">
      <div class="visual-label visual-label-top">
        <span class="signal"></span>
        SYSTEM ARCHITECTURE
      </div>

      <div class="system-map">
        <!-- Connection lines -->
        <svg
          class="connections"
          viewBox="0 0 600 520"
          fill="none"
          aria-hidden="true"
          preserveAspectRatio="none"
        >
          <path
            class="connection connection-one"
            d="M300 260 L140 130"
          />

          <path
            class="connection connection-two"
            d="M300 260 L460 130"
          />

          <path
            class="connection connection-three"
            d="M300 260 L130 390"
          />

          <path
            class="connection connection-four"
            d="M300 260 L470 390"
          />

          <path
            class="connection connection-five"
            d="M140 130 L460 130"
          />

          <path
            class="connection connection-six"
            d="M130 390 L470 390"
          />
        </svg>

        <!-- Central node -->
        <div class="system-node node-core">
          <div class="node-icon">
            API
          </div>

          <span>CORE SYSTEM</span>
        </div>

        <!-- Backend -->
        <div class="system-node node-backend">
          <div class="node-icon">
            BE
          </div>

          <span>BACKEND</span>
          <small>Node · TS · Express</small>
        </div>

        <!-- Database -->
        <div class="system-node node-database">
          <div class="node-icon">
            DB
          </div>

          <span>DATA</span>
          <small>PostgreSQL · Prisma</small>
        </div>

        <!-- Frontend -->
        <div class="system-node node-frontend">
          <div class="node-icon">
            UI
          </div>

          <span>FRONTEND</span>
          <small>React · Ant Design</small>
        </div>

        <!-- Integrations -->
        <div class="system-node node-integrations">
          <div class="node-icon">
            INT
          </div>

          <span>INTEGRATIONS</span>
          <small>APIs · Webhooks · S3</small>
        </div>

        <!-- Security -->
        <div class="system-node node-security">
          <div class="node-icon">
            SEC
          </div>

          <span>SECURITY</span>
          <small>RBAC · Auth</small>
        </div>

        <div class="system-packet packet-one"></div>
        <div class="system-packet packet-two"></div>
        <div class="system-packet packet-three"></div>
      </div>

      <div class="visual-label visual-label-bottom">
        <span>BUILD</span>
        <span>DESIGN</span>
        <span>INTEGRATE</span>
        <span>DELIVER</span>
      </div>
    </div>
  </div>

  <div class="hero-scroll">
    <span>SCROLL TO EXPLORE</span>

    <span class="scroll-line"></span>
  </div>
</section>

<style lang="scss">
  @import "../styles/variables";
  @import "../styles/animations";

  // ----------------------------------------------------------
  // Hero
  // ----------------------------------------------------------

  .hero {
    position: relative;

    min-height: 100vh;
    min-height: 100svh;

    display: flex;
    align-items: center;

    overflow: hidden;

    padding-top: $nav-height;
  }

  .hero-grid {
    position: absolute;
    inset: 0;

    opacity: 0.35;

    background-image:
      linear-gradient(
        rgba(255, 255, 255, 0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.035) 1px,
        transparent 1px
      );

    background-size: 56px 56px;

    mask-image: linear-gradient(
      to bottom,
      black 0%,
      rgba(0, 0, 0, 0.65) 60%,
      transparent 100%
    );
  }

  .hero-glow {
    position: absolute;

    width: 40rem;
    height: 40rem;

    border-radius: 50%;

    pointer-events: none;

    filter: blur(30px);

    animation: glow-pulse 6s ease-in-out infinite;
  }

  .hero-glow-one {
    top: -20rem;
    right: -10rem;

    background:
      radial-gradient(
        circle,
        rgba(77, 163, 255, 0.12),
        transparent 68%
      );
  }

  .hero-glow-two {
    bottom: -24rem;
    left: 10%;

    background:
      radial-gradient(
        circle,
        rgba(139, 124, 255, 0.09),
        transparent 68%
      );

    animation-delay: 1.5s;
  }

  .hero-container {
    position: relative;
    z-index: 1;

    display: grid;

    grid-template-columns:
      minmax(0, 1.05fr)
      minmax(420px, 0.95fr);

    align-items: center;

    gap: 4rem;

    padding-block: 7rem 6rem;
  }

  // ----------------------------------------------------------
  // Hero content
  // ----------------------------------------------------------

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;

    margin-bottom: 1.75rem;

    font-family: $font-mono;
    font-size: $text-xs;
    font-weight: $weight-medium;
    letter-spacing: 0.08em;
    text-transform: uppercase;

    color: $text-secondary;
  }

  .status-dot {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: $success;

    box-shadow:
      0 0 0 4px rgba(85, 214, 160, 0.08),
      0 0 16px rgba(85, 214, 160, 0.35);

    animation: pulse 2.4s ease-in-out infinite;
  }

  .hero-title {
    max-width: 820px;

    margin: 0;

    font-size: clamp(
      3.4rem,
      6.3vw,
      6.3rem
    );

    line-height: 0.96;
    letter-spacing: -0.055em;
  }

  .hero-outline {
    color: transparent;

    -webkit-text-stroke: 1px rgba(
      244,
      247,
      251,
      0.55
    );
  }

  .hero-description {
    max-width: 650px;

    margin-top: 2rem;

    font-size: clamp(
      1rem,
      1.6vw,
      1.2rem
    );

    line-height: 1.8;

    color: $text-secondary;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;

    margin-top: 2.25rem;
  }

  .hero-actions .button span {
    font-family: $font-mono;
  }

  // ----------------------------------------------------------
  // Metrics
  // ----------------------------------------------------------

  .hero-metrics {
    display: flex;
    align-items: center;

    gap: 1.75rem;

    margin-top: 4rem;
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .metric strong {
    font-family: $font-mono;

    font-size: $text-2xl;
    font-weight: $weight-semibold;

    letter-spacing: -0.04em;

    color: $text-primary;
  }

  .metric span {
    font-size: $text-xs;
    color: $text-muted;
  }

  .metric-divider {
    width: 1px;
    height: 34px;

    background: $border-default;
  }

  // ----------------------------------------------------------
  // System visual
  // ----------------------------------------------------------

  .system-visual {
    position: relative;

    min-height: 560px;

    border: 1px solid $border-subtle;
    border-radius: $radius-xl;

    background:
      radial-gradient(
        circle at center,
        rgba(77, 163, 255, 0.045),
        transparent 55%
      ),
      rgba(255, 255, 255, 0.015);

    box-shadow:
      inset 0 0 80px rgba(77, 163, 255, 0.025);

    overflow: hidden;
  }

  .system-visual::before {
    content: "";

    position: absolute;
    inset: 0;

    background-image:
      linear-gradient(
        rgba(255, 255, 255, 0.025) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.025) 1px,
        transparent 1px
      );

    background-size: 36px 36px;

    mask-image: radial-gradient(
      circle at center,
      black,
      transparent 75%
    );
  }

  .visual-label {
    position: absolute;
    z-index: 5;

    display: flex;
    align-items: center;

    font-family: $font-mono;
    font-size: 0.6rem;
    font-weight: $weight-medium;
    letter-spacing: 0.12em;

    color: $text-muted;
  }

  .visual-label-top {
    top: 1.25rem;
    left: 1.5rem;

    gap: 0.6rem;
  }

  .visual-label-bottom {
    right: 1.5rem;
    bottom: 1.25rem;
    left: 1.5rem;

    justify-content: space-between;

    padding-top: 1rem;

    border-top: 1px solid $border-subtle;
  }

  .signal {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: $success;

    box-shadow: 0 0 10px rgba(85, 214, 160, 0.4);

    animation: pulse 2s ease-in-out infinite;
  }

  // ----------------------------------------------------------
  // System map
  // ----------------------------------------------------------

  .system-map {
    position: absolute;

    inset: 3.5rem 1.25rem 3.5rem;

    min-height: 450px;
  }

  .connections {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;
  }

  .connection {
    stroke: rgba(77, 163, 255, 0.16);
    stroke-width: 1;
    stroke-dasharray: 5 8;

    animation:
      draw-line 2s $ease-out forwards;
  }

  .connection-two {
    animation-delay: 150ms;
  }

  .connection-three {
    animation-delay: 300ms;
  }

  .connection-four {
    animation-delay: 450ms;
  }

  .connection-five {
    animation-delay: 600ms;
  }

  .connection-six {
    animation-delay: 750ms;
  }

  // ----------------------------------------------------------
  // Nodes
  // ----------------------------------------------------------

  .system-node {
    position: absolute;
    z-index: 3;

    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;

    width: 132px;
    min-height: 94px;

    padding: 0.75rem;

    border: 1px solid $border-default;
    border-radius: $radius-md;

    background:
      linear-gradient(
        180deg,
        rgba(16, 23, 34, 0.94),
        rgba(11, 17, 26, 0.94)
      );

    box-shadow:
      0 12px 35px rgba(0, 0, 0, 0.25);

    text-align: center;

    transition:
      transform $transition-base,
      border-color $transition-base,
      box-shadow $transition-base;
  }

  .system-node:hover {
    transform: translateY(-5px);

    border-color: rgba(77, 163, 255, 0.35);

    box-shadow:
      0 18px 45px rgba(0, 0, 0, 0.3),
      0 0 25px rgba(77, 163, 255, 0.06);
  }

  .system-node span {
    margin-top: 0.5rem;

    font-family: $font-mono;
    font-size: 0.6rem;
    font-weight: $weight-semibold;
    letter-spacing: 0.08em;

    color: $text-primary;
  }

  .system-node small {
    margin-top: 0.3rem;

    font-size: 0.55rem;
    line-height: 1.4;

    color: $text-muted;
  }

  .node-icon {
    display: grid;
    place-items: center;

    width: 32px;
    height: 32px;

    border: 1px solid rgba(77, 163, 255, 0.2);
    border-radius: $radius-sm;

    background: rgba(77, 163, 255, 0.06);

    font-family: $font-mono;
    font-size: 0.55rem;
    font-weight: $weight-semibold;

    color: $accent-blue;
  }

  .node-core {
    top: 50%;
    left: 50%;

    width: 150px;
    min-height: 110px;

    transform: translate(-50%, -50%);

    border-color: rgba(77, 163, 255, 0.28);

    background:
      radial-gradient(
        circle at center,
        rgba(77, 163, 255, 0.12),
        rgba(11, 17, 26, 0.96) 68%
      );

    box-shadow:
      0 0 0 1px rgba(77, 163, 255, 0.05),
      0 0 60px rgba(77, 163, 255, 0.08);
  }

  .node-core:hover {
    transform: translate(-50%, -50%) translateY(-5px);
  }

  .node-core .node-icon {
    width: 38px;
    height: 38px;

    border-color: rgba(77, 163, 255, 0.35);

    background: rgba(77, 163, 255, 0.1);
  }

  .node-backend {
    top: 9%;
    left: 8%;
  }

  .node-database {
    top: 9%;
    right: 8%;
  }

  .node-frontend {
    bottom: 9%;
    left: 7%;
  }

  .node-integrations {
    right: 7%;
    bottom: 9%;
  }

  .node-security {
    top: 48%;
    left: 3%;

    transform: translateY(-50%);
  }

  .node-security:hover {
    transform: translateY(calc(-50% - 5px));
  }

  // ----------------------------------------------------------
  // Moving packets
  // ----------------------------------------------------------

  .system-packet {
    position: absolute;
    z-index: 4;

    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: $accent-blue;

    box-shadow:
      0 0 10px rgba(77, 163, 255, 0.8);
  }

  .packet-one {
    top: 37%;
    left: 35%;

    animation: packet-one 3.5s linear infinite;
  }

  .packet-two {
    top: 63%;
    left: 63%;

    animation: packet-two 4s linear infinite;
  }

  .packet-three {
    top: 49%;
    left: 50%;

    animation: packet-three 3s linear infinite;
  }

  @keyframes packet-one {
    0% {
      opacity: 0;
      transform: translate(-80px, -60px);
    }

    15% {
      opacity: 1;
    }

    85% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translate(80px, 60px);
    }
  }

  @keyframes packet-two {
    0% {
      opacity: 0;
      transform: translate(70px, 60px);
    }

    15% {
      opacity: 1;
    }

    85% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translate(-70px, -60px);
    }
  }

  @keyframes packet-three {
    0%,
    100% {
      opacity: 0.2;
      transform: scale(0.8);
    }

    50% {
      opacity: 1;
      transform: scale(1.4);
    }
  }

  // ----------------------------------------------------------
  // Scroll indicator
  // ----------------------------------------------------------

  .hero-scroll {
    position: absolute;
    z-index: 2;

    right: 2rem;
    bottom: 2rem;

    display: flex;
    align-items: center;
    gap: 0.75rem;

    font-family: $font-mono;
    font-size: 0.55rem;
    letter-spacing: 0.12em;

    color: $text-muted;
  }

  .scroll-line {
    width: 42px;
    height: 1px;

    background: $border-strong;
  }

  // ----------------------------------------------------------
  // Responsive
  // ----------------------------------------------------------

  @media (max-width: $breakpoint-xl) {
    .hero-container {
      grid-template-columns:
        minmax(0, 1fr)
        minmax(360px, 0.8fr);

      gap: 2rem;
    }

    .system-visual {
      min-height: 500px;
    }

    .system-map {
      transform: scale(0.92);
      transform-origin: center;
    }
  }

  @media (max-width: $breakpoint-lg) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 4rem;

      padding-block: 6rem 5rem;
    }

    .hero-content {
      max-width: 850px;
    }

    .system-visual {
      max-width: 720px;
      width: 100%;

      margin-inline: auto;
    }

    .hero-scroll {
      display: none;
    }
  }

  @media (max-width: $breakpoint-md) {
    .hero-container {
      padding-block: 5rem 4rem;
    }

    .hero-title {
      font-size: clamp(
        3rem,
        13vw,
        5rem
      );
    }

    .hero-description {
      margin-top: 1.5rem;
    }

    .hero-actions {
      align-items: stretch;
      flex-direction: column;

      max-width: 320px;
    }

    .hero-metrics {
      gap: 1rem;
      margin-top: 3rem;
    }

    .metric strong {
      font-size: $text-xl;
    }

    .metric span {
      font-size: 0.65rem;
    }

    .system-visual {
      min-height: 460px;
    }

    .system-map {
      inset: 3.5rem 0.5rem 3.5rem;
      transform: scale(0.8);
    }
  }

  @media (max-width: $breakpoint-sm) {
    .hero-title {
      font-size: clamp(
        2.8rem,
        14vw,
        4rem
      );
    }

    .hero-metrics {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .metric-divider {
      display: none;
    }

    .system-visual {
      min-height: 390px;
    }

    .system-map {
      transform: scale(0.67);
    }

    .system-node {
      width: 118px;
    }

    .node-core {
      width: 138px;
    }

    .node-security {
      display: none;
    }

    .visual-label-bottom {
      gap: 0.5rem;
      font-size: 0.5rem;
    }
  }

  // ----------------------------------------------------------
  // Reduced motion
  // ----------------------------------------------------------

  @media (prefers-reduced-motion: reduce) {
    .hero-glow,
    .status-dot,
    .signal,
    .connection,
    .system-packet {
      animation: none;
    }
  }
</style>