---
import type { Experience } from "../data/experience";

interface Props {
  items: Experience[];
}

const { items } = Astro.props;
---

<div class="timeline">
  <div class="timeline-line" aria-hidden="true"></div>

  {
    items.map((item, index) => (
      <article class:list={["timeline-item", index === 0 && "timeline-item-current"]}>
        <div class="timeline-marker">
          <span></span>
        </div>

        <div class="timeline-period">
          {item.period}
        </div>

        <div class="timeline-content">
          <div class="timeline-heading">
            <div>
              <span class="timeline-company">
                {item.company}
              </span>

              <h3>{item.role}</h3>
            </div>

            {index === 0 && (
              <span class="current-badge">
                CURRENT
              </span>
            )}
          </div>

          <span class="timeline-context">
            {item.context}
          </span>

          <p class="timeline-description">
            {item.description}
          </p>

          <div class="timeline-highlights">
            {
              item.highlights.map((highlight) => (
                <div class="timeline-highlight">
                  <span class="highlight-line"></span>
                  <p>{highlight}</p>
                </div>
              ))
            }
          </div>
        </div>
      </article>
    ))
  }
</div>

<style lang="scss">
  @import "../styles/variables";

  // ----------------------------------------------------------
  // Timeline
  // ----------------------------------------------------------

  .timeline {
    position: relative;

    max-width: 1050px;

    margin-inline: auto;
  }

  .timeline-line {
    position: absolute;

    top: 0.5rem;
    bottom: 0.5rem;
    left: 155px;

    width: 1px;

    background:
      linear-gradient(
        to bottom,
        rgba(77, 163, 255, 0.4),
        $border-subtle 80%,
        transparent
      );
  }

  // ----------------------------------------------------------
  // Timeline item
  // ----------------------------------------------------------

  .timeline-item {
    position: relative;

    display: grid;
    grid-template-columns: 130px 1fr;

    column-gap: 4rem;

    padding-bottom: 5rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  // ----------------------------------------------------------
  // Marker
  // ----------------------------------------------------------

  .timeline-marker {
    position: absolute;

    top: 0.25rem;
    left: 155px;

    z-index: 2;

    display: grid;
    place-items: center;

    width: 12px;
    height: 12px;

    transform: translateX(-50%);

    border: 1px solid rgba(77, 163, 255, 0.35);
    border-radius: 50%;

    background: $bg-primary;
  }

  .timeline-marker span {
    width: 4px;
    height: 4px;

    border-radius: 50%;

    background: $text-muted;
  }

  .timeline-item-current .timeline-marker {
    width: 16px;
    height: 16px;

    border-color: rgba(85, 214, 160, 0.4);

    box-shadow:
      0 0 0 5px rgba(85, 214, 160, 0.05),
      0 0 18px rgba(85, 214, 160, 0.12);
  }

  .timeline-item-current .timeline-marker span {
    width: 5px;
    height: 5px;

    background: $success;

    box-shadow: 0 0 8px rgba(85, 214, 160, 0.6);
  }

  // ----------------------------------------------------------
  // Period
  // ----------------------------------------------------------

  .timeline-period {
    padding-top: 0.1rem;

    font-family: $font-mono;
    font-size: $text-xs;
    line-height: 1.5;

    color: $text-muted;
  }

  // ----------------------------------------------------------
  // Content
  // ----------------------------------------------------------

  .timeline-content {
    min-width: 0;
  }

  .timeline-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 1.5rem;
  }

  .timeline-company {
    display: block;

    margin-bottom: 0.5rem;

    font-family: $font-mono;
    font-size: $text-xs;
    letter-spacing: 0.06em;
    text-transform: uppercase;

    color: $accent-blue;
  }

  .timeline-heading h3 {
    font-size: clamp(
      1.6rem,
      3vw,
      2.15rem
    );

    letter-spacing: -0.035em;
  }

  .current-badge {
    flex-shrink: 0;

    padding: 0.4rem 0.6rem;

    border: 1px solid rgba(85, 214, 160, 0.2);
    border-radius: $radius-pill;

    background: rgba(85, 214, 160, 0.05);

    font-family: $font-mono;
    font-size: 0.55rem;
    font-weight: $weight-medium;
    letter-spacing: 0.1em;

    color: $success;
  }

  .timeline-context {
    display: inline-block;

    margin-top: 0.75rem;

    font-size: $text-sm;

    color: $text-secondary;
  }

  .timeline-description {
    max-width: 700px;

    margin-top: 1.25rem;

    font-size: $text-base;
    line-height: 1.75;
  }

  // ----------------------------------------------------------
  // Highlights
  // ----------------------------------------------------------

  .timeline-highlights {
    display: grid;
    gap: 0.7rem;

    margin-top: 1.5rem;
  }

  .timeline-highlight {
    display: grid;
    grid-template-columns: 18px 1fr;

    gap: 0.65rem;

    align-items: start;
  }

  .highlight-line {
    width: 10px;
    height: 1px;

    margin-top: 0.7rem;

    background: $border-strong;
  }

  .timeline-highlight p {
    font-size: $text-sm;
    line-height: 1.65;
  }

  // ----------------------------------------------------------
  // Hover
  // ----------------------------------------------------------

  .timeline-content {
    transition:
      transform $transition-base;
  }

  .timeline-item:hover .timeline-content {
    transform: translateX(4px);
  }

  .timeline-item:hover .highlight-line {
    background: $accent-blue;
  }

  // ----------------------------------------------------------
  // Responsive
  // ----------------------------------------------------------

  @media (max-width: $breakpoint-md) {
    .timeline-line {
      left: 6px;
    }

    .timeline-item {
      display: block;

      padding-left: 2rem;
      padding-bottom: 4rem;
    }

    .timeline-marker {
      left: 6px;
    }

    .timeline-period {
      margin-bottom: 1rem;
    }

    .timeline-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.75rem;
    }
  }

  @media (max-width: $breakpoint-sm) {
    .timeline-item {
      padding-bottom: 3.5rem;
    }

    .timeline-heading h3 {
      font-size: 1.5rem;
    }

    .timeline-description {
      font-size: $text-sm;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-content {
      transition: none;
    }
  }
</style>