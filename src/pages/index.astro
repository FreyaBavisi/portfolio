---
import "../styles/globals.scss";

import Navigation from "../components/Navigation.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Timeline from "../components/Timeline.astro";
import TechStack from "../components/TechStack.astro";

import { projects } from "../data/projects";
import { experience } from "../data/experience";
import { skillGroups } from "../data/skills";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Freya — Backend-focused Full Stack Developer building production systems, APIs, and SaaS applications."
    />

    <meta
      name="theme-color"
      content="#070b12"
    />

    <title>
      Freya — Backend-focused Full Stack Developer
    </title>
  </head>

  <body>
    <Navigation />

    <main>
      <!-- ==================================================
           HERO
      ================================================== -->

      <Hero />

      <!-- ==================================================
           SELECTED SYSTEMS
      ================================================== -->

      <section
        id="systems"
        class="section systems-section"
      >
        <div class="container">
          <div class="section-header">
            <div class="section-heading">
              <span class="eyebrow">
                Selected systems
              </span>

              <h2>
                Systems I've worked on.
              </h2>
            </div>

            <p class="section-description">
              Production applications across pharmacy ERP,
              medicine data, EV charging, and SaaS workflows.
            </p>
          </div>

          <div class="projects-grid">
            {
              projects.map((project, index) => (
                <ProjectCard
                  project={project}
                  index={index}
                />
              ))
            }
          </div>
        </div>
      </section>

      <!-- ==================================================
           ENGINEERING OWNERSHIP
      ================================================== -->

      <section
        id="ownership"
        class="section ownership-section"
      >
        <div class="container">
          <div class="section-header">
            <div class="section-heading">
              <span class="eyebrow">
                Engineering ownership
              </span>

              <h2>
                Things I own.
              </h2>
            </div>

            <p class="section-description">
              From database design and APIs to integrations,
              security, business logic, and technical delivery.
            </p>
          </div>

          <div class="ownership-grid">
            <article class="ownership-card">
              <span class="ownership-number">
                01
              </span>

              <h3>
                Backend Architecture
              </h3>

              <p>
                API architecture, service boundaries,
                business logic, and backend workflows.
              </p>
            </article>

            <article class="ownership-card">
              <span class="ownership-number">
                02
              </span>

              <h3>
                Database Systems
              </h3>

              <p>
                Relational schema design, migrations,
                data relationships, and cross-service data flows.
              </p>
            </article>

            <article class="ownership-card">
              <span class="ownership-number">
                03
              </span>

              <h3>
                Business Logic
              </h3>

              <p>
                Turning complex operational requirements
                into reliable application workflows.
              </p>
            </article>

            <article class="ownership-card">
              <span class="ownership-number">
                04
              </span>

              <h3>
                Integrations
              </h3>

              <p>
                Webhooks, payment systems, messaging,
                storage services, and external APIs.
              </p>
            </article>

            <article class="ownership-card">
              <span class="ownership-number">
                05
              </span>

              <h3>
                Data Workflows
              </h3>

              <p>
                CSV imports, master-data flows, reporting,
                exports, and bulk processing.
              </p>
            </article>

            <article class="ownership-card">
              <span class="ownership-number">
                06
              </span>

              <h3>
                Technical Delivery
              </h3>

              <p>
                Feature scoping, implementation planning,
                delegation, PR reviews, and delivery coordination.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- ==================================================
           CAREER
      ================================================== -->

      <section
        id="career"
        class="section career-section"
      >
        <div class="container">
          <div class="section-header">
            <div class="section-heading">
              <span class="eyebrow">
                Career evolution
              </span>

              <h2>
                From building features<br />
                to owning systems.
              </h2>
            </div>

            <p class="section-description">
              A progression from backend development to
              broader technical ownership across multiple domains.
            </p>
          </div>

          <Timeline items={experience} />
        </div>
      </section>

      <!-- ==================================================
           TECHNOLOGY
      ================================================== -->

      <section
        id="stack"
        class="section stack-section"
      >
        <div class="container">
          <div class="section-header">
            <div class="section-heading">
              <span class="eyebrow">
                Technology
              </span>

              <h2>
                Tools I build with.
              </h2>
            </div>

            <p class="section-description">
              A backend-heavy full-stack toolkit built through
              production experience rather than isolated demos.
            </p>
          </div>

          <TechStack skillGroups={skillGroups} />
        </div>
      </section>

      <!-- ==================================================
           ABOUT
      ================================================== -->

      <section
        id="about"
        class="section about-section"
      >
        <div class="container about-layout">
          <div>
            <span class="eyebrow">
              About
            </span>

            <h2>
              I like understanding
              <span class="gradient-text">
                how systems actually work.
              </span>
            </h2>
          </div>

          <div class="about-copy">
            <p>
              I'm a backend-focused full-stack developer with
              3+ years of professional experience building
              production applications across different domains.
            </p>

            <p>
              My work has taken me from EV charging software
              to pharmacy ERP systems, medicine master data,
              SaaS subscriptions, integrations, and operational
              business workflows.
            </p>

            <p>
              I enjoy taking a requirement that starts as a
              business problem and turning it into a system that
              is structured, maintainable, and actually works
              in production.
            </p>
          </div>
        </div>
      </section>

      <!-- ==================================================
           CONTACT
      ================================================== -->

      <section
        id="contact"
        class="section contact-section"
      >
        <div class="container">
          <div class="contact-card">
            <div>
              <span class="eyebrow">
                Let's connect
              </span>

              <h2>
                Have a system<br />
                worth building?
              </h2>

              <p>
                I'm open to conversations about backend,
                full-stack, and engineering ownership opportunities.
              </p>
            </div>

            <div class="contact-actions">
              <a
                href="mailto:freyabavisi@gmail.com"
                class="button button-primary"
              >
                Get in touch
              </a>

              <a
                href="/resume.pdf"
                class="button button-secondary"
                target="_blank"
                rel="noopener noreferrer"
              >
                View resume
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- ====================================================
         FOOTER
    ==================================================== -->

    <footer class="footer">
      <div class="container footer-inner">
        <span>
          © {new Date().getFullYear()} Freya
        </span>

        <span class="footer-tech">
          Built with Astro · TypeScript · SCSS
        </span>
      </div>
    </footer>
  </body>
</html>

<style lang="scss">
  @use "../styles/variables" as *;

  // ----------------------------------------------------------
  // Projects
  // ----------------------------------------------------------

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /*
    ServiRx is the featured project.

    Because ProjectCard.astro is a child component,
    :global() is required here for Astro's scoped CSS.
  */

  .projects-grid > :global(.project-card--featured) {
    grid-column: 1 / -1;
  }

  // ----------------------------------------------------------
  // Ownership
  // ----------------------------------------------------------

  .ownership-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 1px;

    overflow: hidden;

    border: 1px solid $border-subtle;
    border-radius: $radius-lg;

    background: $border-subtle;
  }

  .ownership-card {
    min-height: 250px;

    padding: 2rem;

    background: $bg-secondary;

    transition:
      background $transition-base,
      transform $transition-base;
  }

  .ownership-card:hover {
    background: $bg-surface;
  }

  .ownership-number {
    display: block;

    margin-bottom: 3rem;

    color: $text-muted;

    font-family: $font-mono;
    font-size: $text-xs;
  }

  .ownership-card h3 {
    margin-bottom: 0.75rem;

    font-size: $text-xl;
  }

  .ownership-card p {
    max-width: 300px;

    line-height: 1.7;
  }

  // ----------------------------------------------------------
  // About
  // ----------------------------------------------------------

  .about-layout {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 0.8fr);

    gap: 7rem;

    align-items: start;
  }

  .about-layout h2 {
    max-width: 620px;

    margin-top: 1.5rem;
  }

  .about-copy {
    display: grid;

    gap: 1.5rem;

    padding-top: 2.5rem;
  }

  .about-copy p {
    font-size: $text-lg;

    line-height: 1.8;
  }

  // ----------------------------------------------------------
  // Contact
  // ----------------------------------------------------------

  .contact-card {
    position: relative;

    display: flex;

    align-items: flex-end;
    justify-content: space-between;

    gap: 3rem;

    overflow: hidden;

    padding: 4rem;

    border: 1px solid $border-default;
    border-radius: $radius-xl;

    background:
      radial-gradient(
        circle at 85% 30%,
        rgba(77, 163, 255, 0.12),
        transparent 22rem
      ),
      $bg-secondary;
  }

  .contact-card h2 {
    margin-top: 1.5rem;
  }

  .contact-card p {
    max-width: 540px;

    margin-top: 1.5rem;

    font-size: $text-lg;

    line-height: 1.7;
  }

  .contact-actions {
    display: flex;

    flex-shrink: 0;

    gap: 0.75rem;
  }

  // ----------------------------------------------------------
  // Footer
  // ----------------------------------------------------------

  .footer {
    padding-block: 2rem;

    border-top: 1px solid $border-subtle;

    color: $text-muted;

    font-size: $text-sm;
  }

  .footer-inner {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 2rem;
  }

  .footer-tech {
    font-family: $font-mono;

    font-size: $text-xs;
  }

  // ----------------------------------------------------------
  // Responsive
  // ----------------------------------------------------------

  @media (max-width: $breakpoint-lg) {
    .ownership-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

    .about-layout {
      gap: 4rem;
    }

    .contact-card {
      align-items: flex-start;

      flex-direction: column;
    }
  }

  @media (max-width: $breakpoint-md) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    /*
      On mobile every project occupies one row,
      including the featured ServiRx card.
    */

    .projects-grid > :global(.project-card--featured) {
      grid-column: auto;
    }

    .ownership-grid {
      grid-template-columns: 1fr;
    }

    .about-layout {
      grid-template-columns: 1fr;

      gap: 2rem;
    }

    .about-copy {
      padding-top: 0;
    }

    .contact-card {
      padding: 2rem;
    }

    .contact-actions {
      width: 100%;

      flex-wrap: wrap;
    }

    .footer-inner {
      align-items: flex-start;

      flex-direction: column;
    }
  }

  @media (max-width: $breakpoint-sm) {
    .contact-actions {
      flex-direction: column;
    }

    .contact-actions .button {
      width: 100%;
    }
  }
</style>